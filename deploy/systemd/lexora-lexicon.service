[Unit]
Description=Lexora Open Lexicon API
After=network-online.target
Wants=network-online.target

[Service]
User=lexora
Group=lexora
WorkingDirectory=/opt/lexora-lexicon
ExecStart=/opt/lexora-lexicon/.venv/bin/uvicorn service.server:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/lexora-lexicon

[Install]
WantedBy=multi-user.target
