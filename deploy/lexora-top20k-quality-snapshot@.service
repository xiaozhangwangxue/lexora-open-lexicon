[Unit]
Description=Cache Lexora top-20k quality progress for shard %i
# This read-only scan must not be ordered behind the ordinary progress
# snapshot.  A queued systemd job is outside TimeoutStartSec and could wait
# forever if that unrelated unit stalls.

[Service]
Type=oneshot
User=opc
WorkingDirectory=/opt/lexora
ExecStart=/usr/bin/python3 /opt/lexora/tools/write_top20k_quality_snapshot.py \
  --dataset /opt/lexora/build/lexora-open-oxford-scope.sqlite \
  --candidate /opt/lexora/deployments/repair/current/build/lexora-open-oxford-safe-20k.sqlite \
  --output /opt/lexora/state/top20k-quality-shard-%i.json \
  --shard-index %i --shard-count 2 --unresolved-limit 8
# Keep the hourly read-only scan below the active repair/collector (Nice=10),
# while still granting it enough disk service to finish on the E2 micro VM.
# IOSchedulingClass=idle could be starved indefinitely by WAL writes.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=12min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lexora/state
