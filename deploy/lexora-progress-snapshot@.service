[Unit]
Description=Cache exact Lexora enrichment progress for shard %i
After=lexora-enrich-micro@%i.service

[Service]
Type=oneshot
User=opc
WorkingDirectory=/opt/lexora
ExecStart=/usr/bin/python3 /opt/lexora/tools/write_progress_snapshot.py \
  --dataset /opt/lexora/build/lexora-open-oxford-scope.sqlite \
  --state /opt/lexora/state/shard-%i.sqlite \
  --output /opt/lexora/state/progress-shard-%i.json \
  --shard-index %i --shard-count 2
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lexora/state
