[Unit]
Description=Lexora open lexicon enrichment shard %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/lexora
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/lexora/.env
Environment=LEXORA_EDGE_URL=https://dict.12323456.xyz/internal
ExecStart=/usr/bin/python3 /opt/lexora/tools/enrich_oxford_scope.py \
  --dataset /opt/lexora/build/lexora-open-oxford-scope.sqlite \
  --state /opt/lexora/state/shard-%i.sqlite \
  --shard-index %i --shard-count 4 \
  --profile auto \
  --workers 8 --delay 34 --translation-delay 34 --retry-after-hours 8760
# Finish the first pass over pending entries before spending the free daily
# provider budget retrying partial or not-found records.
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lexora/build /opt/lexora/state

[Install]
WantedBy=multi-user.target
