[Unit]
Description=Lexora Open Lexicon relay origin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/lexora
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/lexora/.env
ExecStart=/usr/bin/python3 -m uvicorn service.server:app \
  --host 0.0.0.0 --port 8080 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
