[Unit]
Description=Export completed Lexora enrichment shard %i
After=lexora-enrich-micro@%i.service

[Service]
Type=oneshot
User=opc
WorkingDirectory=/opt/lexora
ExecStart=/usr/bin/python3 /opt/lexora/tools/auto_export_ready_shard.py \
  --dataset /opt/lexora/build/lexora-open-oxford-scope.sqlite \
  --output /opt/lexora/build/exports/fast20k-shard-%i.sqlite \
  --shard-index %i --shard-count 2 --frequency-limit 20000
ExecStart=/usr/bin/python3 /opt/lexora/tools/auto_export_ready_shard.py \
  --dataset /opt/lexora/build/lexora-open-oxford-scope.sqlite \
  --output /opt/lexora/build/exports/full-shard-%i.sqlite \
  --shard-index %i --shard-count 2
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lexora/build
